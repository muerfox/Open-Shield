# Copy this file to .env and edit before running `docker compose up --build`.

### Postgres (shared instance, two databases: panel + pdns) ###
POSTGRES_USER=openshield
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres

### Redis ###
REDIS_PASSWORD=change-me-redis

### PowerDNS ###
PDNS_API_KEY=change-me-pdns-api-key
# Comma-separated list of this server's own nameserver hostnames, used as NS records for new zones.
PDNS_DEFAULT_NS=ns1.example.com,ns2.example.com

### Panel (FastAPI) ###
# Bootstraps the first admin user on first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Long random string used to sign session cookies.
SESSION_SECRET=change-me-session-secret-please-make-this-long-and-random
# Login brute-force lockout (all optional, shown here with their defaults).
# After LOGIN_MAX_ATTEMPTS failures from one IP within LOGIN_FAIL_WINDOW_SECONDS,
# that IP is locked out of /login for LOGIN_LOCKOUT_BASE_SECONDS, doubling on
# each further violation up to LOGIN_LOCKOUT_MAX_SECONDS.
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_FAIL_WINDOW_SECONDS=900
#LOGIN_LOCKOUT_BASE_SECONDS=3600
#LOGIN_LOCKOUT_MAX_SECONDS=86400

### OpenResty / ACME ###
# Email used for Let's Encrypt account registration. Only used to seed the
# panel's Settings page on first boot — after that, change it there instead
# (takes effect live, no restart). Must NOT be on a domain like example.com/
# .net/.org/.edu/test/invalid/localhost — Let's Encrypt rejects those.
ACME_EMAIL=you@yourdomain.com

### Edge ###
# Public IP (or hostname) of this server's OpenResty edge. Used by the panel
# to auto-point a proxied domain's A record at the edge in PowerDNS.
EDGE_PUBLIC_HOST=203.0.113.10
