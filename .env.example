# Copy this file to .env and edit before running `docker compose up --build`.

### Postgres (shared instance, two databases: panel + pdns) ###
POSTGRES_USER=openshield
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres

### Redis ###
REDIS_PASSWORD=change-me-redis

### PowerDNS ###
PDNS_API_KEY=change-me-pdns-api-key
# Comma-separated list of this server's own nameserver hostnames, used as NS records for new zones.
PDNS_DEFAULT_NS=ns1.example.com,ns2.example.com

### Panel (FastAPI) ###
# Bootstraps the first admin user on first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Long random string used to sign session cookies.
SESSION_SECRET=change-me-session-secret-please-make-this-long-and-random

### OpenResty / ACME ###
# Email used for Let's Encrypt account registration.
ACME_EMAIL=admin@example.com

### Edge ###
# Public IP (or hostname) of this server's OpenResty edge. Used by the panel
# to auto-point a proxied domain's A record at the edge in PowerDNS.
EDGE_PUBLIC_HOST=203.0.113.10
